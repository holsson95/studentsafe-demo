# Portfolio demo mode: when true, almaService.js and emailService.js never make
# real outbound calls (no live Alma API requests, no real emails sent).
DEMO_MODE=true

# For local/docker-compose Postgres, use the discrete vars below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=studentsafe_demo

# For hosted Postgres (Neon, Render, etc.), set DATABASE_URL instead — it
# takes priority over the DB_* vars above (see server/db.js). Must include
# sslmode=require.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=
ALMA_KEY=unused-in-demo-mode
ALMA_SECRET=unused-in-demo-mode
CUSTOM_FIELD_API_NATIONALITY=
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
ALLOWED_ORIGIN=http://localhost:5173
